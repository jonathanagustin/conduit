{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)(Dockerfile|Containerfile)(\\.[^/]*)?$/"
    ]
  },
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "schedule": [
    "before 5am on Monday"
  ],
  "packageRules": [
    {
      "description": "Keep captured Apollo CLI conformance fixtures immutable",
      "matchFileNames": [
        "docs/reference-platform/cli-fixtures/**"
      ],
      "enabled": false
    },
    {
      "description": "Keep Vite+ core and Vitest catalog pins tied to the bundle; update them with the parent Vite+ release",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/package.json",
        "web/pnpm-workspace.yaml"
      ],
      "matchDepNames": [
        "vite",
        "vitest",
        "@voidzero-dev/vite-plus-core"
      ],
      "enabled": false
    },
    {
      "description": "Keep the HiGHS builder on its audited base until the frozen native compiler closure is requalified (#590)",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "Containerfile.optimizer-highs"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "enabled": false
    },
    {
      "description": "Keep optimizer qualification workflows source-bound to their recorded evidence; updates require a deliberate requalification, not a hash refresh",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/platform-cpsat-candidate.yml",
        ".github/workflows/platform-highs-candidate.yml"
      ],
      "enabled": false
    },
    {
      "description": "Use the official HTTP version feed for the mise Grok tool instead of GitHub tags",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "grok"
      ],
      "overrideDatasource": "custom.grok-stable",
      "overridePackageName": "grok",
      "versioning": "semver"
    },
    {
      "description": "Group digest-pinned GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep container bases pinned by tag and digest",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Group non-major Go dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go dependencies"
    },
    {
      "description": "Require review for major dependency updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "automerge": false,
  "customDatasources": {
    "grok-stable": {
      "defaultRegistryUrlTemplate": "https://x.ai/cli/stable",
      "format": "plain"
    }
  }
}
