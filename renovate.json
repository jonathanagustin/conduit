{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "labels": [
    "dependencies"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)(Dockerfile|Containerfile)(\\.[^/]*)?$/"
    ]
  },
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "schedule": [
    "before 5am on Monday"
  ],
  "packageRules": [
    {
      "description": "Keep captured Apollo CLI conformance fixtures immutable",
      "matchFileNames": [
        "docs/reference-platform/cli-fixtures/**"
      ],
      "enabled": false
    },
    {
      "description": "Use the official HTTP version feed for the mise Grok tool instead of GitHub tags",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "grok"
      ],
      "overrideDatasource": "custom.grok-stable",
      "overridePackageName": "grok",
      "versioning": "semver"
    },
    {
      "description": "Group digest-pinned GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep container bases pinned by tag and digest",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Group non-major Go dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go dependencies"
    },
    {
      "description": "Require review for major dependency updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "automerge": false,
  "customDatasources": {
    "grok-stable": {
      "defaultRegistryUrlTemplate": "https://x.ai/cli/stable",
      "format": "plain"
    }
  }
}
