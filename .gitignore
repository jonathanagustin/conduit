.platform-delivery/
ui-ref/
coverage.out
dist/
!internal/consoleui/dist/
internal/consoleui/dist/**
!internal/consoleui/dist/README.txt
*.tmp
.env
.direnv/
web/.stryker-tmp/

# `go build ./cmd/<name>` writes the binary to the working directory, which is
# the repository root. ci.yml's build step does exactly that for all six, so a
# local run of the same commands leaves six committable binaries behind.
/conduit
/platform-delivery
/platform-grype-scanner
/platform-module-publisher
/platform-operator
/platform-spoke-agent
/platform-optimizer
/packaging-workflow
.packaging-state/

# Demo recordings stay outside git. The manual Demo Video workflow uploads them.
demo/out/

# Local verification tool cache (scripts/verify-local.sh downloads pinned
# binaries here; its comment already assumes this is ignored).
.cache/

# Per-person overrides of `.claude/settings.json`. The committed file is the
# team's agreement; this one is somebody's own machine and must not become a
# silent, unreviewable amendment to it.
.claude/settings.local.json

# Scratch checkouts an agent tool creates to work on several branches at once.
# These are `git worktree` directories, so each holds a full second copy of the
# tree; committing one would commit the repository into itself. They are
# machine-local and disappear when the work does.
.claude/worktrees/

# The review-ledger self-test writes throwaway ledger copies beside the real
# one, because `topic` resolves relative to the ledger directory. The EXIT trap
# removes them; this covers a SIGKILL.
docs/reference-platform/reference/.review-ledger-selftest.*

# Isolated Release Please contract-test dependencies.
tools/release-please/node_modules/

# Isolated offline YAML language-service verification dependencies.
tools/workspace-schemas/node_modules/

# Built by `task zarf:create` and `task uds:create`, which must write beside
# zarf.yaml because the bundle references the package by `path: .`.
deploy/zarf/*.tar.zst

# Native package-template compilation; commit the reviewed template instead.
deploy/zarf/zarf.gen.yaml
