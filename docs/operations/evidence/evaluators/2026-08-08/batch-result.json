        "findings": [
          {
            "id": "gemini-F1",
            "clusterKey": "twin-snapshot-nondeterminism",
            "category": "correctness",
            "target": "platform/internal/optimization/twin.go:139",
            "summary": "TwinSnapshot FactIDs for stale facts are appended in the non-deterministic input order of facts, causing unstable snapshot identities.",
            "confidence": "1/1",
            "evidence": [
              "Because twinSnapshotID hashes the JSON representation of these fields, different input orders of the same facts produce different snapshot IDs.",
              "In BuildTwinSnapshot, stale facts are appended to the stale slice as they are encountered in the unsorted facts input.",
              "The stale slice is then iterated to populate field.FactIDs without sorting, unlike the matching slice which is explicitly sorted."
            ],
            "hypothesis": true
          },
          {
            "id": "gemini-F2",
            "clusterKey": "evaluator-token-overflow",
            "category": "correctness",
            "target": "platform/internal/optimization/evaluator.go:120",
            "summary": "Token usage sum can silently overflow int64 to exactly zero, incorrectly rejecting valid non-empty evaluator runs.",
            "confidence": "1/1",
            "evidence": [
              "If the sum overflows to exactly 0 (e.g., each field is 1\u003c\u003c62), the validation fails with 'requires non-negative, non-empty measured token usage'.",
              "Unlike cost calculations in scheduler.go and value.go, this sum lacks an overflow check against math.MaxInt64.",
              "validateEvaluatorRun sums InputTokens, OutputTokens, CacheReadTokens, and CacheWriteTokens using int64 addition."
            ],
            "hypothesis": true
          },
          {
            "id": "gemini-F3",
            "clusterKey": "evaluator-fdr-labeled-fpr",
            "category": "documentation",
            "target": "platform/internal/optimization/evaluator.go:346",
            "summary": "EvaluatorMetric.FalsePositiveRate computes the False Discovery Rate (FP / (TP + FP)) rather than the statistical False Positive Rate.",
            "confidence": "1/1",
            "evidence": [
              "DisposedFindings is the sum of VerifiedDefects (TP) and FalsePositives (FP).",
              "MeasureEvaluatorBatch calculates FalsePositiveRate as metric.FalsePositives / metric.DisposedFindings.",
              "The ratio FP / (TP + FP) is the False Discovery Rate, whereas False Positive Rate is strictly FP / Actual Negatives."
            ],
            "hypothesis": true
          },
          {
            "id": "gemini-F4",
            "clusterKey": "scheduler-absolute-tolerance",
            "category": "correctness",
            "target": "platform/internal/optimization/scheduler.go:231",
            "summary": "Absolute tolerance of 1e-9 fails to absorb float64 rounding errors for large demands or capacities, breaking max-flow feasibility checks.",
            "confidence": "1/1",
            "evidence": [
              "For large values (e.g., 1e15), float64 precision gaps far exceed 1e-9, causing valid max-flows to be rejected due to normal floating-point rounding.",
              "The feasible function checks g.max(source, sink)+tolerance \u003c total using a hardcoded absolute tolerance of 1e-9.",
              "WorkItem.Demand and Resource.Capacity are only bounded by being finite and positive."
            ],
            "hypothesis": true
          }
        ]
      },
