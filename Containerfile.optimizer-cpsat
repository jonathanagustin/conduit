# syntax=docker/dockerfile:1.19

ARG BUILDER_IMAGE=rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

FROM ${BUILDER_IMAGE} AS build

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG BUILDARCH
ARG TARGETARCH
ARG REVISION=WORKTREE

ENV CARGO_HOME=/tmp/platform-cpsat-cargo \
    CARGO_TARGET_DIR=/tmp/platform-cpsat-target \
    SOURCE_DATE_EPOCH=1768232310 \
