ADD --checksum=sha256:62c7a1e35f56406896d7aa7ca52d0cc0d272ac022b5d2796e7d6905db8a3636a \
    https://raw.githubusercontent.com/rust-lang/rust/2d8144b7880597b6e6d3dfd63a9a9efae3f533d3/LICENSE-APACHE \
    /tmp/rust-LICENSE-APACHE
ADD --checksum=sha256:b71bd43a069ca0641a9ecfe585ca7b3c53b5cc1608f8b68321168698e28b5ea1 \
    https://raw.githubusercontent.com/rust-lang/rust/2d8144b7880597b6e6d3dfd63a9a9efae3f533d3/LICENSE-MIT \
    /tmp/rust-LICENSE-MIT
ADD --checksum=sha256:172020dbfd5b53a226dfde77616190a48dcff519b0bc0e6deb91a8450782c4af \
    https://raw.githubusercontent.com/rust-lang/rust/2d8144b7880597b6e6d3dfd63a9a9efae3f533d3/COPYRIGHT \
    /tmp/rust-COPYRIGHT

WORKDIR /src
COPY solver/cpsat-adapter /src/adapter
COPY LICENSE NOTICE Containerfile.optimizer-cpsat /src/platform/
COPY scripts/scan-cpsat-candidate.sh scripts/verify-cpsat-candidate.sh scripts/verify-cpsat-candidate.test.sh /src/platform/scripts/
COPY internal/optimization /src/platform/internal/optimization

RUN --mount=type=cache,id=platform-cpsat-cargo,target=/tmp/platform-cpsat-cargo,sharing=locked \
    --mount=type=cache,id=platform-cpsat-rust-target,target=/tmp/platform-cpsat-target,sharing=locked \
    set -eux; \
    test "$BUILDARCH" = "$TARGETARCH"; \
    test "$(rustc --version)" = 'rustc 1.97.0 (2d8144b78 2026-07-07)'; \
    case "$TARGETARCH" in \
      amd64) bazelisk_sha='5a408715e932c0250d28bd84555f12edbf70117de42f9181691c736eacc4a992' ;; \
      arm64) bazelisk_sha='e20e8b0f4f240091b7a55bf17b9398bd4f40ee70ae0208dff95dd4c445fb4010' ;; \
      *) exit 2 ;; \
    esac; \
    curl --fail --location --retry 3 \
      --output /usr/local/bin/bazelisk \
      "https://github.com/bazelbuild/bazelisk/releases/download/v1.29.0/bazelisk-linux-${TARGETARCH}"; \
    printf '%s  %s\n' "$bazelisk_sha" /usr/local/bin/bazelisk | sha256sum --check --strict; \
    chmod 0755 /usr/local/bin/bazelisk; \
    mkdir /src/ortools; \
    tar --extract --gzip --file /tmp/or-tools-9.15.tar.gz --directory /src/ortools --strip-components=1; \
    cargo test --manifest-path /src/adapter/Cargo.toml --locked; \
    cargo build --manifest-path /src/adapter/Cargo.toml --locked --release --lib --features native; \
    install -m 0644 "$CARGO_TARGET_DIR/release/libplatform_cpsat_adapter.a" /src/ortools/ortools/sat/c_api/; \
    install -m 0644 /src/adapter/native/platform_cpsat_bridge.cc /src/ortools/ortools/sat/c_api/; \
    install -m 0644 /src/adapter/native/platform_cpsat_bridge.h /src/ortools/ortools/sat/c_api/; \
    install -m 0644 /src/adapter/native/platform_cpsat_main.cc /src/ortools/ortools/sat/c_api/; \
    install -m 0644 /src/adapter/native/platform_targets.BUILD.bazel /src/ortools/ortools/sat/c_api/BUILD.bazel

WORKDIR /src/ortools

RUN --mount=type=cache,id=platform-cpsat-cargo,target=/tmp/platform-cpsat-cargo,sharing=locked \
    --mount=type=cache,id=platform-cpsat-bazel,target=/tmp/platform-cpsat-bazel,sharing=locked \
    --mount=type=cache,id=platform-cpsat-bazelisk,target=/root/.cache/bazelisk,sharing=locked \
    set -eux; \
    mkdir -p /out; \
    bazelisk --output_base=/tmp/platform-cpsat-bazel build \
      --announce_rc \
      --jobs=2 \
      --stamp=no \
      --strip=always \
      //ortools/sat/c_api:platform-cpsat-adapter; \
    bazelisk --output_base=/tmp/platform-cpsat-bazel aquery \
      'mnemonic("CppLink", //ortools/sat/c_api:platform-cpsat-adapter)' \
      --output=textproto > /out/link-action.textproto; \
    install -m 0755 bazel-bin/ortools/sat/c_api/platform-cpsat-adapter /out/platform-cpsat-adapter; \
    strip --strip-all /out/platform-cpsat-adapter; \
    chmod 0555 /out/platform-cpsat-adapter; \
    file /out/platform-cpsat-adapter | tee /out/file.txt; \
    grep -Fq 'statically linked' /out/file.txt; \
    readelf -d /out/platform-cpsat-adapter | tee /out/dynamic-section.txt; \
    if grep -Eq 'NEEDED|libstdc\+\+|libgcc_s' /out/dynamic-section.txt; then exit 1; fi; \
    sha256sum /out/platform-cpsat-adapter | \
      sed 's#  /out/#  #' > /out/platform-cpsat-adapter.sha256; \
    bazel_external="$(bazelisk --output_base=/tmp/platform-cpsat-bazel info output_base)/external"; \
    mkdir -p /out/licenses/cargo; \
    install -m 0444 /src/ortools/LICENSE /out/licenses/OR-TOOLS-LICENSE; \
    install -m 0444 "$bazel_external/abseil-cpp+/LICENSE" /out/licenses/ABSEIL-LICENSE; \
    install -m 0444 "$bazel_external/protobuf+/LICENSE" /out/licenses/PROTOBUF-LICENSE; \
    install -m 0444 "$bazel_external/zlib+/LICENSE" /out/licenses/ZLIB-LICENSE; \
    install -m 0444 /tmp/rust-LICENSE-APACHE /out/licenses/RUST-LICENSE-APACHE; \
    install -m 0444 /tmp/rust-LICENSE-MIT /out/licenses/RUST-LICENSE-MIT; \
    install -m 0444 /tmp/rust-COPYRIGHT /out/licenses/RUST-COPYRIGHT; \
    install -m 0444 /usr/share/doc/libc6/copyright /out/licenses/GLIBC-COPYRIGHT; \
    install -m 0444 /usr/share/doc/gcc-12-base/copyright /out/licenses/GCC-RUNTIME-COPYRIGHT; \
    install -m 0444 /src/platform/LICENSE /out/licenses/PLATFORM-LICENSE; \
    install -m 0444 /src/platform/NOTICE /out/licenses/PLATFORM-NOTICE; \
    cargo tree --manifest-path /src/adapter/Cargo.toml --locked --edges normal \
      --prefix none --format '{p}|{l}' | \
      sed 's# (/src/adapter)##' | LC_ALL=C sort -u > /out/cargo-closure.tsv; \
    { \
      sha256sum \
        /src/adapter/Cargo.lock \
        /src/adapter/Cargo.toml \
        /src/adapter/src/native.rs \
        /src/adapter/native/platform_cpsat_bridge.cc \
        /src/adapter/native/platform_cpsat_bridge.h \
        /src/adapter/native/platform_cpsat_main.cc \
        /src/adapter/native/platform_targets.BUILD.bazel | \
        sed 's#  /src/adapter/#  solver/cpsat-adapter/#'; \
      sha256sum \
        /src/platform/Containerfile.optimizer-cpsat \
        /src/platform/LICENSE \
        /src/platform/NOTICE \
        /src/platform/scripts/scan-cpsat-candidate.sh \
        /src/platform/scripts/verify-cpsat-candidate.sh \
        /src/platform/scripts/verify-cpsat-candidate.test.sh | \
        sed 's#  /src/platform/#  #'; \
      find /src/platform/internal/optimization -maxdepth 1 -type f -name '*.go' -print0 | \
        LC_ALL=C sort -z | xargs -0 sha256sum | sed 's#  /src/platform/#  #'; \
    } > /out/platform-source-hashes.sha256; \
    set +x; \
    find "$CARGO_HOME/registry/src" -mindepth 3 -maxdepth 3 -type f \
      \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname '*NOTICE*' \) | \
      LC_ALL=C sort > /tmp/platform-cpsat-cargo-license-files; \
    while IFS= read -r license; do \
      crate="$(basename "$(dirname "$license")")"; \
      mkdir -p "/out/licenses/cargo/$crate"; \
      install -m 0444 "$license" "/out/licenses/cargo/$crate/$(basename "$license")"; \
    done < /tmp/platform-cpsat-cargo-license-files; \
    printf '%b\n' \
      'component\tversion\tlicense-evidence' \
      'OR-Tools\t9.15.6755\tlicenses/OR-TOOLS-LICENSE' \
      'Abseil\t20250814.1\tlicenses/ABSEIL-LICENSE' \
      'Protobuf\t32.0\tlicenses/PROTOBUF-LICENSE' \
      'zlib\t1.3.1.bcr.7\tlicenses/ZLIB-LICENSE' \
      'Rust\t1.97.0\tlicenses/RUST-LICENSE-APACHE,licenses/RUST-LICENSE-MIT,licenses/RUST-COPYRIGHT' \
      "glibc\t$(dpkg-query -W -f='${Version}' libc6)\tlicenses/GLIBC-COPYRIGHT" \
      "GCC-runtime\t$(dpkg-query -W -f='${Version}' gcc-12-base)\tlicenses/GCC-RUNTIME-COPYRIGHT" \
      'Cargo-normal-closure\tCargo.lock\tcargo-closure.tsv,licenses/cargo/' \
      'Distroless-static-debian12\tsha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a\t/usr/share/doc/,/usr/share/common-licenses/' \
      "Platform-adapter\t${REVISION}\tlicenses/PLATFORM-LICENSE,licenses/PLATFORM-NOTICE" \
      > /out/static-closure.tsv; \
    find /out/licenses -type f -print0 | LC_ALL=C sort -z | \
      xargs -0 sha256sum | sed 's#  /out/#  #' > /out/license-hashes.sha256; \
    printf '%s\n' \
      'OR-Tools=9.15.6755 source=sha256:599c870319bb127441d92c452d8f79bca46ca6fd295c1deb8031ed303a361311' \
      'Rust=1.97.0 commit=2d8144b7880597b6e6d3dfd63a9a9efae3f533d3' \
      'Bazelisk=1.29.0 Bazel=8.7.0 jobs=2' \
      "PlatformRevision=${REVISION}" > /out/build-inputs.txt; \
    find /out -depth -exec touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" {} +; \
    find /out -type d -exec chmod 0555 {} +; \
    find /out -type f ! -name platform-cpsat-adapter -exec chmod 0444 {} +; \
    mkdir -p /runtime/usr/share/platform-cpsat/evidence /runtime/usr/share/platform-cpsat/licenses; \
    for evidence in \
      build-inputs.txt cargo-closure.tsv dynamic-section.txt file.txt \
      license-hashes.sha256 link-action.textproto platform-cpsat-adapter.sha256 \
      platform-source-hashes.sha256 static-closure.tsv; do \
      install -m 0444 "/out/$evidence" "/runtime/usr/share/platform-cpsat/evidence/$evidence"; \
    done; \
    cp -a /out/licenses/. /runtime/usr/share/platform-cpsat/licenses/; \
    install -m 0555 /out/platform-cpsat-adapter /runtime/platform-cpsat-adapter; \
    find /runtime -depth -exec touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" {} +; \
    find /runtime -type d -exec chmod 0555 {} +; \
    set -x

