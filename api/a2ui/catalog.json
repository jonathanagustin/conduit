  "functions": {
    "required": {
      "type": "object",
      "properties": {
        "@call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/DynamicValue"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ],
      "returnType": "boolean",
      "allowedCallers": "rendererOnly"
    },
    "pattern": {
      "type": "object",
      "properties": {
        "@call": {
          "const": "pattern"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/DynamicValue"
            },
            "pattern": {
              "enum": [
                "^[0-9]+$",
                "^[A-Za-z0-9_.-]+$",
                "^https://[A-Za-z0-9./_-]+$"
              ]
            }
          },
          "required": [
            "value",
            "pattern"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ],
      "returnType": "boolean",
      "allowedCallers": "rendererOnly"
    },
    "enum": {
      "type": "object",
      "properties": {
        "@call": {
          "const": "enum"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/DynamicValue"
            },
            "options": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "maxItems": 32,
              "minItems": 1
            }
          },
          "required": [
            "value",
            "options"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ],
      "returnType": "boolean",
      "allowedCallers": "rendererOnly"
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Text"
        },
        {
          "$ref": "#/components/TextField"
        },
        {
          "$ref": "#/components/TextArea"
        },
        {
          "$ref": "#/components/CheckBox"
        },
        {
          "$ref": "#/components/Select"
        },
        {
          "$ref": "#/components/RadioGroup"
        },
        {
          "$ref": "#/components/Button"
        },
        {
          "$ref": "#/components/Column"
        },
        {
          "$ref": "#/components/Row"
        }
      ]
    },
    "anyFunction": {
      "oneOf": [
        {
          "$ref": "#/functions/required"
        },
        {
          "$ref": "#/functions/pattern"
        },
        {
          "$ref": "#/functions/enum"
        }
      ]
    }
  }
