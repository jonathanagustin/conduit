{
  "catalogId": "conduit:planning-forms/v1",
  "protocolVersion": "1.0",
  "title": "Conduit planning forms",
  "description": "Approved inert text, draft inputs, layout and human form submission. No script, URL or remote function component.",
  "components": {
    "Text": {
      "type": "object",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/DataBinding"
            }
          ]
        }
      },
      "required": [
        "component",
