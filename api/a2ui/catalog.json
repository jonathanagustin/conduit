        },
        "action": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "context": {
                  "type": "object",
                  "maxProperties": 64,
                  "additionalProperties": {
                    "$ref": "https://a2ui.org/specification/v1_0/common_types.json#/$defs/DynamicValue"
                  }
                }
              },
              "required": [
