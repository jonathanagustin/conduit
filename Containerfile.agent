# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG GO_IMAGE=golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
ARG HELM_IMAGE=alpine/helm:4.2.3@sha256:b97ba4f9b27fe7af16ee3d37e6815783c9d4a51289b6240a9024ec471611ae9b
ARG RUNTIME_IMAGE=cgr.dev/chainguard/static:latest@sha256:399c8cb4858f05aaa33f43f02a2e75f28d40f016c0f86e5ba6075769e3303791

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
# Serialise the compiler on a memory-constrained builder with
# --build-arg GO_BUILD_JOBS=1. EMPTY BY DEFAULT, which is Go's own parallelism,
# so CI and release builds are byte-for-byte what they were. A 15 GB codespace
# OOMs the linker without it — but hardcoding the serial path would have made
# every CI build pay for one machine's constraint, forever and invisibly.
ARG GO_BUILD_JOBS=
WORKDIR /source
COPY go.mod go.sum ./
COPY cmd cmd
COPY internal internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOMAXPROCS=${GO_BUILD_JOBS:-0} \
    go build ${GO_BUILD_JOBS:+-p $GO_BUILD_JOBS} -trimpath -buildvcs=false \
    -ldflags="-s -w -X github.com/jonathanagustin/conduit/internal/buildinfo.Version=$VERSION -X github.com/jonathanagustin/conduit/internal/buildinfo.Commit=$COMMIT -X github.com/jonathanagustin/conduit/internal/buildinfo.BuildDate=$BUILD_DATE" \
    -o /out/platform-spoke-agent ./cmd/platform-spoke-agent

# Helm 4.2.3 predates the oras-go 2.6.2 traversal fix. Rebuild the exact Helm
# release source with only that fixed module version. The source archive and Go
# module graph are integrity-pinned; the resulting binary remains Helm 4.2.3.
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS helm-build
ARG TARGETOS
ARG TARGETARCH
ARG GO_BUILD_JOBS=
ADD --checksum=sha256:9ca555fa3777082fd646c95abf4ee17fc31e25ba97bad76da9de1df2332be168 \
    https://github.com/helm/helm/archive/refs/tags/v4.2.3.tar.gz /tmp/helm-source.tar.gz
WORKDIR /source
RUN tar -xzf /tmp/helm-source.tar.gz --strip-components=1 && \
    go get oras.land/oras-go/v2@v2.6.2 && \
    go mod download
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOMAXPROCS=${GO_BUILD_JOBS:-0} \
    go build ${GO_BUILD_JOBS:+-p $GO_BUILD_JOBS} -trimpath -buildvcs=false \
    -ldflags='-s -w -X helm.sh/helm/v4/internal/version.version=v4.2.3 -X helm.sh/helm/v4/internal/version.gitCommit=43e8b7feece8beb0fcba47059ec9b522fd929a64 -X helm.sh/helm/v4/internal/version.gitTreeState=clean' \
    -o /out/helm ./cmd/helm

# Kubernetes 1.36.3 is the current stable release, but its published kubectl
# binary predates the fixed x/net and x/text releases. Build the release source
# with narrowly pinned replacements instead of accepting known High findings.
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS kubectl-build
ARG TARGETOS
ARG TARGETARCH
ARG GO_BUILD_JOBS=
ADD --checksum=sha256:c3144dc4c33a1d597422254e21c4143cbad78795271d6d61ddb3c71596320878 \
    https://dl.k8s.io/v1.36.3/kubernetes-src.tar.gz /tmp/kubernetes-source.tar.gz
WORKDIR /source
RUN tar -xzf /tmp/kubernetes-source.tar.gz && \
    go mod edit \
      -replace=golang.org/x/net=golang.org/x/net@v0.56.0 \
      -replace=golang.org/x/text=golang.org/x/text@v0.39.0
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOWORK=off GOFLAGS=-mod=mod \
    GOMAXPROCS=${GO_BUILD_JOBS:-0} \
    go build ${GO_BUILD_JOBS:+-p $GO_BUILD_JOBS} -trimpath -buildvcs=false \
    -ldflags='-s -w -X k8s.io/component-base/version.gitVersion=v1.36.3 -X k8s.io/component-base/version.gitCommit=0f29094e5b73085e3802ecc1298ecae13866bfe6 -X k8s.io/component-base/version.gitTreeState=clean -X k8s.io/component-base/version.buildDate=2026-07-22T18:07:38Z' \
    -o /out/kubectl ./cmd/kubectl

# The Helm 3 compatibility lane can substitute its pinned upstream executable;
# production builds default to the patched Helm 4 binary above. Both land in a
# minimal, non-shell runtime rather than inheriting scanner-visible utilities.
FROM ${HELM_IMAGE} AS helm-upstream
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS runtime-assembly
ARG USE_UPSTREAM_HELM=false
COPY --from=helm-build /out/helm /tools/patched-helm
COPY --from=helm-upstream /usr/bin/helm /tools/upstream-helm
COPY --from=kubectl-build /out/kubectl /tools/kubectl
RUN case "$USE_UPSTREAM_HELM" in \
      true) cp /tools/upstream-helm /out-helm ;; \
      false) cp /tools/patched-helm /out-helm ;; \
      *) exit 1 ;; \
    esac && chmod 0755 /out-helm /tools/kubectl

FROM ${RUNTIME_IMAGE}
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="Platform Spoke Agent" \
      org.opencontainers.image.description="Outbound-only platform Spoke agent" \
      org.opencontainers.image.source="https://github.com/jonathanagustin/palantir" \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$COMMIT \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build --chown=65532:65532 --chmod=0755 /out/platform-spoke-agent /platform-spoke-agent
COPY --from=runtime-assembly --chown=65532:65532 --chmod=0755 /out-helm /usr/local/bin/helm
COPY --from=runtime-assembly --chown=65532:65532 --chmod=0755 /tools/kubectl /usr/local/bin/kubectl
ENV HELM_CACHE_HOME=/tmp/helm/cache
ENV HELM_CONFIG_HOME=/tmp/helm/config
ENV HELM_DATA_HOME=/tmp/helm/data
USER 65532:0
ENTRYPOINT ["/platform-spoke-agent"]
