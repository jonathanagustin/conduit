{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "crossnamespacediscoverytargets.deploy.palantir.com"
  },
  "spec": {
    "conversion": {
      "strategy": "None"
    },
    "group": "deploy.palantir.com",
    "names": {
      "categories": [
        "all"
      ],
      "kind": "CrossNamespaceDiscoveryTarget",
      "listKind": "CrossNamespaceDiscoveryTargetList",
      "plural": "crossnamespacediscoverytargets",
      "shortNames": [
        "cndt"
      ],
      "singular": "crossnamespacediscoverytarget"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "description": "Role of the discovery entry to create",
            "jsonPath": ".spec.produceBlock.role",
            "name": "role",
            "type": "string"
          },
          {
            "description": "Stack name of the discovery entry to create",
            "jsonPath": ".spec.stackName",
            "name": "stackName",
            "type": "string"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "properties": {
              "spec": {
                "properties": {
                  "labelSelector": {
                    "properties": {
                      "matchExpressions": {
                        "items": {
                          "properties": {
                            "key": {
                              "type": "string"
                            },
                            "operator": {
                              "type": "string"
                            },
                            "values": {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "matchLabels": {
                        "type": "object",
                        "x-kubernetes-preserve-unknown-fields": true
                      }
                    },
                    "type": "object"
                  },
                  "produceBlock": {
                    "properties": {
                      "producingPayload": {
                        "type": "object",
                        "x-kubernetes-preserve-unknown-fields": true
                      },
                      "role": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "producingPayload",
                      "role"
                    ],
                    "type": "object"
                  },
                  "stackName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "tagging": {
                    "properties": {
                      "tags": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "targetNamespaces": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "stackName",
                  "produceBlock",
                  "targetNamespaces",
                  "labelSelector"
                ],
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "type": "object"
          }
        },
        "served": true,
        "storage": true
      }
    ]
  }
}
