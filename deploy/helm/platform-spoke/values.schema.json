{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "environmentId", "agentId", "controlPlaneURL", "serviceAccount", "rbac", "tls"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
    "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
    "imagePullSecrets": {"type": "array", "items": {"$ref": "#/definitions/localObjectReference"}},
    "environmentId": {"$ref": "#/definitions/dnsName"},
    "agentId": {"$ref": "#/definitions/dnsName"},
    "controlPlaneURL": {"type": "string", "pattern": "^https://[^[:space:]]+$"},
    "serviceAccount": {"$ref": "#/definitions/serviceAccount"},
    "rbac": {"$ref": "#/definitions/rbac"},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "runtimeSupplementalGroups": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientSecretName", "externalCAConfigMapName", "externalCAKey"],
      "properties": {
        "clientSecretName": {"$ref": "#/definitions/dnsName"},
        "externalCAConfigMapName": {"$ref": "#/definitions/dnsName"},
        "externalCAKey": {"type": "string", "minLength": 1}
      }
    },
    "leaseDuration": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
    "pollInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
    "helmTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
    "helmPlainHTTP": {"type": "boolean"},
    "healthPollInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
    "healthProbeCAConfigMapName": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "healthProbeCAKey": {"type": "string", "minLength": 1},
    "materialPreparer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "toolsPersistentVolumeClaimName", "toolsMountPath"],
      "properties": {
        "command": {"type": "string", "pattern": "^$|^(/[A-Za-z0-9._+-]+)+$", "maxLength": 4096},
        "toolsPersistentVolumeClaimName": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
        "toolsMountPath": {"type": "string", "pattern": "^(/[A-Za-z0-9._+-]+)+$"}
      }
    },
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "sampleRatio",
        "caConfigMap"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^$|^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$",
          "maxLength": 2048
        },
        "sampleRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "caConfigMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "localObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/definitions/dnsName"}}
    },
    "dnsName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "packageExecutor", "managedNamespaces"],
      "properties": {
        "create": {"type": "boolean"},
        "packageExecutor": {"type": "boolean"},
        "managedNamespaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/dnsName"}}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
