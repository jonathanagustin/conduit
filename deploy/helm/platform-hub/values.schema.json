{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "bootstrapAdministrators", "replicaCount", "repository", "consoleBootstrap", "serviceAccount", "service", "rubix", "tls", "bundleSigningSecretName", "operatorOIDC", "artifactScanner", "storage"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
    "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
    "imagePullSecrets": {"type": "array", "items": {"$ref": "#/definitions/localObjectReference"}},
    "bootstrapAdministrators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 20},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "postgres"],
      "properties": {
        "kind": {"type": "string", "enum": ["file", "postgres"]},
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "dsnKey"],
          "properties": {
            "secretName": {"$ref": "#/definitions/optionalDnsName"},
            "dsnKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 253}
          }
        }
      }
    },
    "consoleBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tenant", "brand", "provenance"],
      "properties": {
        "schemaVersion": {"const": "conduit.console.bootstrap/v1"},
        "tenant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "displayName"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$"},
            "displayName": {"$ref": "#/definitions/displayText80"}
          }
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "subtitle", "accent", "icon"],
          "properties": {
            "title": {"$ref": "#/definitions/displayText80"},
            "subtitle": {"$ref": "#/definitions/displayText120"},
            "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "icon": {"type": "string", "enum": ["application", "cloud", "dashboard"]}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimClass", "evidenceRef"],
          "properties": {
            "claimClass": {"type": "string", "enum": ["tenant-observation", "conduit-extension"]},
            "evidenceRef": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(evidence|conduit)://[^?#]+$"}
          },
          "allOf": [
            {"if": {"properties": {"claimClass": {"const": "tenant-observation"}}}, "then": {"properties": {"evidenceRef": {"pattern": "^evidence://[^?#]+$"}}}},
            {"if": {"properties": {"claimClass": {"const": "conduit-extension"}}}, "then": {"properties": {"evidenceRef": {"pattern": "^conduit://[^?#]+$"}}}}
          ]
        }
      }
    },
    "serviceAccount": {"$ref": "#/definitions/serviceAccount"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "port"],
      "properties": {
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "rubix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["podCertificate", "spp"],
      "properties": {
        "podCertificate": {"type": "boolean"},
        "spp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "contextPath", "domainAlias"],
          "properties": {
            "enabled": {"type": "boolean"},
            "contextPath": {"type": "string", "pattern": "^/"},
            "domainAlias": {"type": "string", "pattern": "^$|^[A-Za-z0-9.-]+$"}
          }
        }
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "runtimeSupplementalGroups": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverSecretName", "externalCAConfigMapName", "externalCAKey"],
      "properties": {
        "serverSecretName": {"$ref": "#/definitions/dnsName"},
        "externalCAConfigMapName": {"$ref": "#/definitions/dnsName"},
        "externalCAKey": {"type": "string", "minLength": 1}
      }
    },
    "bundleSigningSecretName": {"$ref": "#/definitions/dnsName"},
    "operatorOIDC": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "profile", "issuer", "jwksURL", "clientID", "usernameClaim", "groupsClaim", "serviceAccountClaim", "audienceClaim", "tokenPurposeClaim", "expectedTokenPurpose", "scopeClaim", "requiredScopes", "signingAlgorithms", "caFile"],
      "properties": {
        "enabled": {"type": "boolean"},
        "profile": {"type": "string", "enum": ["generic", "multipass", "cognito-access"]},
        "issuer": {"type": "string", "pattern": "^$|^https://[^?#]+$"},
        "jwksURL": {"type": "string", "pattern": "^$|^https://[^?#]+$"},
        "clientID": {"type": "string", "maxLength": 256},
        "usernameClaim": {"type": "string", "maxLength": 128},
        "groupsClaim": {"type": "string", "maxLength": 128},
        "serviceAccountClaim": {"type": "string", "maxLength": 128},
        "audienceClaim": {"type": "string", "maxLength": 128},
        "tokenPurposeClaim": {"type": "string", "maxLength": 128},
        "expectedTokenPurpose": {"type": "string", "maxLength": 256},
        "scopeClaim": {"type": "string", "maxLength": 128},
        "requiredScopes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "signingAlgorithms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["RS256", "ES256", "EdDSA"]}},
        "caFile": {"type": "string", "pattern": "^/.+$"}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"issuer": {"minLength": 1}, "clientID": {"minLength": 1}}}}]
    },
    "artifactScanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeout", "grypeBinaryPath", "grypeConfigFile", "grypeCacheDirectory", "toolsPersistentVolumeClaimName", "toolsMountPath", "cachePersistentVolumeClaimName", "cacheMountPath", "registryAuthSecretName", "registryAuthMountPath"],
      "properties": {
        "command": {"type": "string", "pattern": "^$|^/.*$"},
        "timeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "grypeBinaryPath": {"type": "string", "pattern": "^$|^/.*$"},
        "grypeConfigFile": {"type": "string", "pattern": "^$|^/.*\\.ya?ml$"},
        "grypeCacheDirectory": {"type": "string", "pattern": "^$|^/.*$"},
        "toolsPersistentVolumeClaimName": {"$ref": "#/definitions/optionalDnsName"},
        "toolsMountPath": {"type": "string", "pattern": "^/.+$"},
        "cachePersistentVolumeClaimName": {"$ref": "#/definitions/optionalDnsName"},
        "cacheMountPath": {"type": "string", "pattern": "^/.+$"},
        "registryAuthSecretName": {"$ref": "#/definitions/optionalDnsName"},
        "registryAuthMountPath": {"type": "string", "pattern": "^/.+$"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName", "accessModes"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "storageClassName": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}}
      }
    },
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "temporal", "compute"],
      "properties": {
        "backend": {"type": "string", "enum": ["temporal", "local"]},
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "namespace", "taskQueue"],
          "properties": {
            "address": {"type": "string"},
            "namespace": {"type": "string", "minLength": 1},
            "taskQueue": {"type": "string", "minLength": 1}
          }
        },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["imageBuilder", "gitRoot", "packagingBuild", "httpWriteTimeout"],
          "properties": {
            "imageBuilder": {"type": "string"},
            "gitRoot": {"type": "string"},
            "packagingBuild": {"type": "string"},
            "httpWriteTimeout": {"type": "string"}
          }
        }
      }
    },
    "packagingWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "address", "namespace", "taskQueue", "serverName", "tls", "apiKeySecretName", "worker"],
      "properties": {
        "enabled": {"type": "boolean"},
        "address": {"type": "string"},
        "namespace": {"type": "string", "minLength": 1},
        "taskQueue": {"type": "string", "minLength": 1},
        "serverName": {"type": "string"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certSecretName", "caConfigMapName"],
          "properties": {
            "certSecretName": {"type": "string"},
            "caConfigMapName": {"type": "string"}
          }
        },
        "apiKeySecretName": {"type": "string"},
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"repository": {"properties": {"kind": {"const": "postgres"}}}}},
      "then": {"properties": {"repository": {"properties": {"postgres": {"properties": {"secretName": {"minLength": 1}}}}}}}
    },
    {
      "if": {"properties": {"repository": {"properties": {"kind": {"const": "file"}}}}},
      "then": {"properties": {"replicaCount": {"const": 1}}}
    },
    {
      "if": {"properties": {"planning": {"properties": {"backend": {"const": "temporal"}}}}},
      "then": {"properties": {"planning": {"properties": {"temporal": {"properties": {"address": {"minLength": 1}}}}}}}
    },
    {
      "if": {"properties": {"packagingWorkflow": {"properties": {"enabled": {"const": true}}}}},
      "then": {"properties": {"packagingWorkflow": {"properties": {"address": {"minLength": 1}}}}}
    },
    {
      "if": {"properties": {"packagingWorkflow": {"properties": {"worker": {"properties": {"enabled": {"const": true}}}}}}},
      "then": {"properties": {"repository": {"properties": {"kind": {"const": "postgres"}}}}}
    }
  ],
  "definitions": {
    "displayText80": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^<>[:cntrl:]]+$"},
    "displayText120": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^<>[:cntrl:]]+$"},
    "localObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/definitions/dnsName"}}
    },
    "dnsName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
    "optionalDnsName": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
