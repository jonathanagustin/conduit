{
  "name": "@platform/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Conduit packaging assistant. assistant-ui chat embedded in the Hub under /console/, backed by Codex over ACP.",
  "provenance": {
    "kind": "local-prototype",
    "designBaseline": "https://www.assistant-ui.com/",
    "evidencePolicy": "The assistant uses assistant-ui's default components. It does not claim Apollo or Foundry presentation fidelity. @blueprintjs/core remains a devDependency so the captured Foundry token contract can still be compared; the assistant does not render Blueprint."
  },
  "scripts": {
    "dev": "node src/server/dev.mjs",
    "bridge": "node src/server/main.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "pnpm typecheck && pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.6.0",
    "@agentclientprotocol/sdk": "2.5.0",
    "@assistant-ui/react": "0.15.33",
    "@assistant-ui/react-markdown": "0.14.25",
    "@assistant-ui/react-syntax-highlighter": "0.14.7",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "assistant-stream": "0.3.56",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.2",
    "react-syntax-highlighter": "16.1.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-shimmer": "0.4.14",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@blueprintjs/core": "6.18.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "^4.1.10"
  }
}
