{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server/dev.mjs",
    "dev:template": "next dev --turbopack",
    "build": "node scripts/check-toolchain.mjs && pnpm check:events && vp build",
    "build:next": "next build",
    "preview": "vp preview",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/check-toolchain.mjs && vp test run",
    "test:e2e": "playwright test",
    "test": "pnpm check && pnpm typecheck && pnpm test:unit && pnpm test:e2e",
    "lint": "vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "check:toolchain": "node scripts/check-toolchain.mjs && node --test scripts/check-toolchain.test.mjs scripts/local-ci-browser-profile.test.mjs",
    "check": "pnpm check:deps && pnpm check:toolchain && pnpm check:events && vp check",
    "check:deps": "syncpack lint",
    "fix:deps": "syncpack fix",
    "check:events": "node ../tools/liveevents/generate-validator.mjs --check"
  },
