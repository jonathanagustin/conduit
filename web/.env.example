# Default: real Codex ACP. Authenticate with `codex login` on the server.
# For an entirely simulated workflow without credentials:
# CONDUIT_AGENT_MODE=demo
# CONDUIT_AGENT_WORKSPACE=/absolute/path/to/conduit
# PORT=3000

# Real Temporal workflow, fixture activities; requires server and worker.
# CONDUIT_AGENT_MODE=temporal-demo
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
